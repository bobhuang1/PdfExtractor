{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Extractor",
  "version": "0.1.0",
  "identifier": "org.pdfextractor.ui",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PDF Extractor",
        "width": 820,
        "height": 660,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "resources": {
      "../../target/release/pdfextractor-cli*": ""
    }
  }
}
