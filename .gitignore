/target
# The local release bundle: installers and archives built on this machine, not
# source. The anchor keeps `crates/ui/dist` — the window's frontend, which is
# source — visible; ignoring the folder does not stop a build writing into it.
/dist/
# The bytecode a fixture generator leaves beside itself when it runs, not source:
# `test-data/make_*.py` writes it into `test-data/__pycache__`, and a script run
# through `py_compile`, imported with its cache turned off, or compiled beside
# itself leaves a `*.pyc` next to the source instead. Neither is ever committed.
__pycache__/
*.pyc
*.json
!test-data/expected/*.json
# The Compare mode's per-document numbers: a record, not an output, so it is kept.
!test-data/golden/compare-baseline.json
# Real Docling conversions: golden references, not conversions of ours.
!test-data/golden/docling/*.json
# Docling's own schema, generated from its model: the contract the conformance
# tests read, not an output of ours — a fresh checkout has to carry it.
!test-data/golden/DoclingDocument.json
# The photographed corpus's ground truth: written with the images, not an output.
!test-data/photos/corpus.json
# The window's bundle configuration — source, not output: the release
# workflow builds the installers from it.
!crates/ui/tauri.conf.json
